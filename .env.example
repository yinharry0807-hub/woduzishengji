# ── Supabase 项目配置 ─────────────────────────────
# 在 Supabase Dashboard → Project Settings → API 中获取
NEXT_PUBLIC_SUPABASE_URL=https://你的项目.supabase.co
# 浏览器用的公钥（anon public key），在此粘贴
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 服务端专用：Service Role Key（请勿泄露、请勿放入客户端代码）
# Supabase Dashboard → Project Settings → API → service_role，在此粘贴
SUPABASE_SERVICE_ROLE_KEY=

# ── 会话签名密钥 ──────────────────────────────────
# 用于签名登录 Cookie，生成方式（任选其一）：
#   Windows PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object {Get-Random -Max 256}) -as [byte[]])
#   macOS / Linux:      openssl rand -base64 48
SESSION_SECRET=

# ── DeepSeek AI 顾问 ─────────────────────────────
# 在 https://platform.deepseek.com 创建 API Key 后粘贴到下一行
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 三个可选模型（界面可切换；默认都是 deepseek-chat）
# 如需使用其他模型，把对应变量改成官方模型名即可
DEEPSEEK_MODEL_CHAT=deepseek-chat
DEEPSEEK_MODEL_FLASH=deepseek-chat
DEEPSEEK_MODEL_PRO=deepseek-chat
